NEON_DATABASE_URL=your_neon_database_url

# Neon Auth — Get from: Neon Console → Auth section
# This is used by the backend API
NEON_AUTH_URL=https://ep-your-branch-id.neonauth.your-region.aws.neon.tech/neondb/auth

# Optional: Override frontend auth URL (for local development with custom proxy)
# If not set, frontend will use direct Neon Auth URL in development
# VITE_NEON_AUTH_URL=http://localhost:5173/neon-auth/auth

AUTH_SECRET=your_long_random_secret

# Optional: explicitly enable mock database mode for local development without Neon
# USE_MOCK_DB=true

# Optional: allow insecure cookies (no Secure flag) in local development
# ONLY for http://localhost testing — NEVER in production
# ALLOW_INSECURE_COOKIES=true

# Optional: KiloCode API key for AI chat features (can also be set per-user in app preferences)
# KILOCODE_API_KEY=your_kilocode_api_key

# Optional: Encryption key secret for encrypting user API keys (KiloCode) saved in database preferences.
# If not set, falls back to AUTH_SECRET or a hashed default.
API_KEY_ENCRYPTION_SECRET=your_api_key_encryption_secret_here

# Optional: Secret for the scheduled jobs endpoint (/api/cron). Vercel Cron
# sends `Authorization: Bearer <CRON_SECRET>` automatically. Without it the
# cron endpoint refuses to run. The in-app "Process Recurring" button on the
# Transactions page does NOT need this — it runs as the signed-in user.
# CRON_SECRET=your_long_random_cron_secret
