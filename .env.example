# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
NEON_DATABASE_URL=your_neon_database_url

# ---------------------------------------------------------------------------
# Neon Auth — Get from: Neon Console → Auth section
# This is used by the backend API
NEON_AUTH_URL=https://ep-your-branch-id.neonauth.your-region.aws.neon.tech/neondb/auth

# Optional: Override the Neon Auth base URL for local development. Used by
# both the Vite dev proxy target (/neon-auth) and the frontend auth client;
# if unset, both fall back to the configured Neon Auth endpoint.
# VITE_NEON_AUTH_URL=http://localhost:5173/neon-auth/auth

AUTH_SECRET=your_long_random_secret

# Optional: Public URL of the deployed app. Used as the trusted origin for
# Neon Auth redirects/emails when it cannot be derived from request headers.
# VITE_APP_URL=https://your-app.vercel.app

# Optional: Comma-separated list of extra origins allowed by CORS/auth
# checks (e.g. custom or preview domains).
# ALLOWED_ORIGINS=https://app.example.com,https://preview-example.vercel.app

# ---------------------------------------------------------------------------
# Local server
# ---------------------------------------------------------------------------

# Port for the local Bun API server (default: 3001).
# PORT=3001

# Optional: explicitly enable mock database mode for local development without Neon
# USE_MOCK_DB=true

# Set to true to allow cookies over plain HTTP in local development
# (forces Secure=false). ONLY for http://localhost testing — NEVER in production.
# ALLOW_INSECURE_COOKIES=true

# Optional: dev-only DNS override for the Neon endpoints (api/_utils/dns-bypass.ts).
# Set to 1 to resolve the Neon hosts via public DNS servers (8.8.8.8 / 1.1.1.1)
# on networks where the system resolver fails. Non-production environments only;
# TLS certificate validation is never disabled.
# NEON_DNS_OVERRIDE=1

# ---------------------------------------------------------------------------
# AI (KiloCode)
# ---------------------------------------------------------------------------

# Optional: KiloCode API key for AI chat features (can also be set per-user in app preferences)
# KILOCODE_API_KEY=your_kilocode_api_key

# Optional: Comma-separated override for the curated free-model allowlist
# offered in Settings > Preferences > AI Integration.
# KILOCODE_FREE_MODELS=vendor/model-a:free,vendor/model-b:free

# ---------------------------------------------------------------------------
# Secrets & scheduled jobs
# ---------------------------------------------------------------------------

# Optional: Encryption key secret for encrypting user API keys (KiloCode) saved in database preferences.
# If not set, falls back to AUTH_SECRET or a hashed default.
API_KEY_ENCRYPTION_SECRET=your_api_key_encryption_secret_here

# Optional: Secret for the scheduled jobs endpoint (/api/cron). Vercel Cron
# sends `Authorization: Bearer <CRON_SECRET>` automatically. Without it the
# cron endpoint refuses to run. The in-app "Process Recurring" button on the
# Transactions page does NOT need this — it runs as the signed-in user.
# CRON_SECRET=your_long_random_cron_secret

# ---------------------------------------------------------------------------
# Frontend (Vite — only VITE_* vars are exposed to the client bundle)
# ---------------------------------------------------------------------------

# Optional: set to "true" to show the demo-mode disclaimer under the login form.
# VITE_DEMO_MODE=true
